{
  "manifest_version": 3,
  "name": "Screenora responsive viewer",
  "version": "1.0",
  "description": "Remove X-Frame-Options e CSP de qualquer domínio para permitir visualização no Screenora.",
  "permissions": ["declarativeNetRequest", "contextMenus", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "action": {
    "default_title": "Abrir Screenora"
  },
  "background": {
    "service_worker": "background.js"
  }
}
